# Copie este arquivo para .env.caixa e preencha no seu Mac.
# O arquivo .env.caixa é ignorado pelo Git.

LC_PRO_URL=https://lc-pro-lotofacil.vercel.app

# Login Caixa
CAIXA_CPF=SEU_CPF
CAIXA_SENHA=SUA_SENHA

# Código de validação por Gmail/IMAP
GMAIL_IMAP_EMAIL=seu-email@gmail.com
GMAIL_IMAP_APP_PASSWORD=sua-senha-de-app
GMAIL_IMAP_FROM=logincaixa@caixa.gov.br
GMAIL_IMAP_SUBJECT=Código de Validação
GMAIL_IMAP_LOOKBACK_MINUTES=10

# Opcional: use se o Selenium não encontrar o ChromeDriver sozinho.
# CHROMEDRIVER_PATH=/Users/mac/Documents/Claude/Projects/Apps loteria/Lotofacil automacao/chromedriver-mac-arm64/chromedriver

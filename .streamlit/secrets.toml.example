# LC Pro — Configuração de credenciais
# Copie este arquivo como `.streamlit/secrets.toml` e preencha com suas credenciais.
# `secrets.toml` está no .gitignore — NUNCA commite.

[supabase]
# Encontrados em: Supabase Dashboard → Settings → API
url = "https://YOUR-PROJECT-REF.supabase.co"

# Use service_key (secreto, fica só no servidor — Streamlit nunca expõe ao browser)
# Em Settings → API → "service_role" → "Reveal" → copie aqui
service_key = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
